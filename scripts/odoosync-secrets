#!/usr/bin/env bash
# odoosync-secrets: set and check secrets WITHOUT ever echoing them (ADR-08 3.8, runbook PI.5 item 3).
#   set <NAME>                       read ONE line from a TTY (no echo) or a pipe; never from argv; atomic write, mode 0600
#   check [NAME ...]                 print "<NAME> set|empty|missing" for each name (all names in the file when none are given)
#   hs256-check <NAME> <token-file>  verify one HS256 JWT with the secret NAME; prints ONLY "verifies true|false" and "length <n>"
#   hs256-check --stdin <token-file> the same, with the secret read from stdin (a workstation, from the password manager)
# The secrets file is /etc/odoosync/secrets.env (root:root 0600). No value is ever printed, logged or put in an argument.
set -Eeuo pipefail
umask 077
HERE="$(dirname "$(readlink -f "$0")")"
# shellcheck source=lib/common.sh
. "$HERE/lib/common.sh"

SECRETS="$OS_ETC/secrets.env"
NAME_RE='^[A-Z][A-Z0-9_]{1,63}$'

usage() {
  cat >&2 <<USAGE
usage: odoosync-secrets set <NAME>
       odoosync-secrets check [NAME ...]
       odoosync-secrets hs256-check <NAME> <token-file>
       odoosync-secrets hs256-check --stdin <token-file>
USAGE
  exit 2
}

secrets_ok() { [ ! -e "$SECRETS" ] || trust_file_ok "$SECRETS" || die "$SECRETS must be a regular file, root-owned, mode 0600"; }

# print the value of NAME from the file (empty if missing). Only ever used internally, never printed by this tool.
value_of() { awk -F= -v n="$1" '$1==n { sub(/^[^=]*=/, ""); print; exit }' "$SECRETS" 2>/dev/null || true; }

cmd_set() {
  [ $# -eq 1 ] || usage
  local name="$1" value=""
  [[ "$name" =~ $NAME_RE ]] || die "invalid name"
  secrets_ok
  if [ -t 0 ]; then
    printf '%s: ' "$name" >&2
    IFS= read -rs value || true
    printf '\n' >&2
  else
    IFS= read -r value || true
  fi
  [ -n "$value" ] || die "empty value refused"
  case "$value" in *$'\n'*|*$'\r'*) die "a value must be one line" ;; esac
  mkdir -p -- "$(dirname "$SECRETS")"
  local tmp
  tmp="$(mktemp "$SECRETS.XXXXXX")"
  chmod 600 "$tmp"
  if [ -f "$SECRETS" ]; then grep -v -E "^${name}=" "$SECRETS" > "$tmp" || true; fi
  printf '%s=%s\n' "$name" "$value" >> "$tmp"
  mv -f -- "$tmp" "$SECRETS"
  printf '%s set\n' "$name"
}

cmd_check() {
  secrets_ok
  local names=("$@") n v
  if [ ${#names[@]} -eq 0 ] && [ -f "$SECRETS" ]; then
    mapfile -t names < <(awk -F= '/^[A-Z][A-Z0-9_]*=/ {print $1}' "$SECRETS")
  fi
  for n in "${names[@]}"; do
    [[ "$n" =~ $NAME_RE ]] || die "invalid name"
    if [ -f "$SECRETS" ] && grep -q -E "^${n}=" "$SECRETS"; then
      v="$(value_of "$n")"
      if [ -n "$v" ]; then printf '%s set\n' "$n"; else printf '%s empty\n' "$n"; fi
    else
      printf '%s missing\n' "$n"
    fi
  done
}

cmd_hs256() {
  need python3
  local from_stdin=0 name="" tokfile=""
  if [ "${1:-}" = --stdin ]; then from_stdin=1; shift; [ $# -eq 1 ] || usage; tokfile="$1"
  else [ $# -eq 2 ] || usage; name="$1"; tokfile="$2"; [[ "$name" =~ $NAME_RE ]] || die "invalid name"; fi
  [ -f "$tokfile" ] || die "token file not found"
  local secret
  if [ "$from_stdin" -eq 1 ]; then IFS= read -r secret || true
  else secrets_ok; [ -f "$SECRETS" ] || die "no secrets file"; secret="$(value_of "$name")"; fi
  [ -n "$secret" ] || { printf 'verifies false\nlength 0\n'; return 0; }
  # The secret goes to python through the ENVIRONMENT of this one process, never through argv.
  OS_HS_SECRET="$secret" python3 - "$tokfile" <<'PY'
import base64, hashlib, hmac, os, sys
secret = os.environ["OS_HS_SECRET"].encode()
tok = open(sys.argv[1], encoding="utf-8").read().strip()
ok = False
try:
    h, p, s = tok.split(".")
    pad = lambda x: x + "=" * (-len(x) % 4)
    sig = base64.urlsafe_b64decode(pad(s))
    good = hmac.new(secret, f"{h}.{p}".encode(), hashlib.sha256).digest()
    ok = hmac.compare_digest(sig, good)
except Exception:
    ok = False
print("verifies", "true" if ok else "false")
print("length", len(secret))
PY
}

[ $# -ge 1 ] || usage
case "$1" in
  set) shift; cmd_set "$@" ;;
  check) shift; cmd_check "$@" ;;
  hs256-check) shift; cmd_hs256 "$@" ;;
  *) usage ;;
esac
