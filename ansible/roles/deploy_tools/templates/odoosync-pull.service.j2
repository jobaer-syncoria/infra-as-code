# Managed by Ansible (role deploy_tools). One run of the pull agent; the timer starts it.
[Unit]
Description=odoosync pull agent (verifies signed releases and applies them through odoosync-deploy)
Documentation=file://{{ deploy_tools_dir }}/odoosync-pull
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/sbin/odoosync-pull
# a deploy waits for the health check (up to the policy's readiness_timeout) and the web stop grace: allow for it
TimeoutStartSec=30min
Nice=10
NoNewPrivileges=true
PrivateTmp=true
# The registry login lives in /root/.docker. ProtectHome=true hides /root, so docker would run anonymously and every lookup of a private
# image would fail ("mkdir /root/.docker: read-only file system"). Read-only home, with the docker config folder writable, is enough.
ProtectHome=read-only
ReadWritePaths=-/root/.docker -/root/.sigstore
# a service has no HOME: cosign would not find the registry login (UNAUTHORIZED on a private image)
Environment=HOME=/root
Environment=DOCKER_CONFIG=/root/.docker
