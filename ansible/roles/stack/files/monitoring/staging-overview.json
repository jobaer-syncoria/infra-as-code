{
 "uid": "staging-overview",
 "title": "Staging server overview",
 "tags": [
  "staging"
 ],
 "timezone": "utc",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "id": 100,
   "type": "row",
   "title": "Host",
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "collapsed": false
  },
  {
   "id": 1,
   "type": "stat",
   "title": "CPU used",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[2m])) * 100)",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 70
       },
       {
        "color": "red",
        "value": 90
       }
      ]
     },
     "max": 100
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Memory used",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 4,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 80
       },
       {
        "color": "red",
        "value": 92
       }
      ]
     },
     "max": 100
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Swap used",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 8,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "100 * (1 - node_memory_SwapFree_bytes / node_memory_SwapTotal_bytes)",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 50
       },
       {
        "color": "red",
        "value": 80
       }
      ]
     },
     "max": 100
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Disk used (/)",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 12,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\",fstype!=\"rootfs\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!=\"rootfs\"})",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 75
       },
       {
        "color": "red",
        "value": 90
       }
      ]
     },
     "max": 100
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Load (1 min)",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 16,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "node_load1",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 2
       },
       {
        "color": "red",
        "value": 4
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   }
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Uptime",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 20,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "time() - node_boot_time_seconds",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "CPU by mode",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum by (mode) (rate(node_cpu_seconds_total{mode!=\"idle\"}[2m])) * 100",
     "legendFormat": "{{mode}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Memory",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
     "legendFormat": "used",
     "refId": "A"
    },
    {
     "expr": "node_memory_MemTotal_bytes",
     "legendFormat": "total",
     "refId": "B"
    },
    {
     "expr": "node_memory_SwapTotal_bytes - node_memory_SwapFree_bytes",
     "legendFormat": "swap used",
     "refId": "C"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Disk I/O",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 13
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(rate(node_disk_read_bytes_total[2m]))",
     "legendFormat": "read",
     "refId": "A"
    },
    {
     "expr": "sum(rate(node_disk_written_bytes_total[2m]))",
     "legendFormat": "write",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Disk space (/)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 13
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "node_filesystem_size_bytes{mountpoint=\"/\",fstype!=\"rootfs\"} - node_filesystem_avail_bytes{mountpoint=\"/\",fstype!=\"rootfs\"}",
     "legendFormat": "used",
     "refId": "A"
    },
    {
     "expr": "node_filesystem_size_bytes{mountpoint=\"/\",fstype!=\"rootfs\"}",
     "legendFormat": "size",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 101,
