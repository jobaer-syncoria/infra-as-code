    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   }
  },
  {
   "id": 12,
   "type": "stat",
   "title": "Containers restarted (last 24 h)",
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 6,
    "y": 22
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "count((time() - container_start_time_seconds{name!=\"\"}) < 86400) or vector(0)",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
