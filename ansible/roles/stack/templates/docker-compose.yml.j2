# Managed by Ansible (role stack). Same services as the hand-built staging stack.
name: {{ compose_project }}
services:
  postgres:
    image: {{ img_postgres }}
    restart: unless-stopped
    env_file: infra.env
    volumes: [pgdata17:/var/lib/postgresql/data]
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U omnisync -d omnisync"]
      interval: 5s
      retries: 10
  rabbit:
    image: {{ img_rabbit }}
    restart: unless-stopped
    env_file: infra.env
    hostname: rabbit
  web:
    build: ../omnisync-py312
    image: omnisync-stg:local
    restart: unless-stopped
    env_file: omnisync.env
    # the committed gunicorn config (gthread, 3 x 16, path-only access log); migrate first
    command: >
      bash -c "python wait_for_postgres.py && python manage.py migrate --noinput &&
      exec newrelic-admin run-program gunicorn -c deploy/gunicorn_web.conf.py omnisync.wsgi:application"
    ports: ["127.0.0.1:8000:8000"]
    depends_on: {postgres: {condition: service_healthy}, rabbit: {condition: service_started}}
  worker:
    image: omnisync-stg:local
    restart: unless-stopped
    env_file: omnisync.env
    command: celery -A omnisync worker -l info
    depends_on: [web]
  admin:
    build:
      context: ../syncoria-connector-admin
      args:
        VITE_API_BASE_URL: http://{{ public_host_eff }}/api
    image: admin-stg:local
    restart: unless-stopped
  edge:
    image: {{ img_nginx }}
    restart: unless-stopped
    volumes: ["./nginx.conf:/etc/nginx/conf.d/default.conf:ro"]
    ports: ["80:80"]
    depends_on: [web, admin]
{% if not stack_external_mongo %}
  mongo:
    image: {{ img_mongo }}
    restart: unless-stopped
    env_file: mongo.env
    volumes: [mongodata:/data/db]
{% endif %}
  clover-node:
    build:
      context: ../odoo-clover-cloud
    image: clover-node-stg:local
    restart: unless-stopped
    env_file: [clover.env, clover-conn.env]
    ports: ["{{ clover_ui_port }}:8081"]
{% if not stack_external_mongo %}
    depends_on: [mongo]
{% endif %}
  # makes 127.0.0.1:8000 inside clover-node reach omnisync (as on the real host, where it is a loopback listener)
  sc-bridge:
    image: {{ img_socat }}
    restart: unless-stopped
    network_mode: "service:clover-node"
    command: TCP-LISTEN:8000,fork,reuseaddr TCP:web:8000
    depends_on: [clover-node, web]
{% if monitoring_enabled %}
  prometheus:
    image: {{ img_prometheus }}
    restart: unless-stopped
    command: ["--config.file=/etc/prometheus/prometheus.yml", "--storage.tsdb.path=/prometheus", "--storage.tsdb.retention.time=15d"]
    volumes: ["./monitoring/prometheus.yml:/etc/prometheus/prometheus.yml:ro", "promdata:/prometheus"]
  node-exporter:
    image: {{ img_node_exporter }}
    restart: unless-stopped
    pid: host
    command: ["--path.rootfs=/host", "--collector.filesystem.mount-points-exclude=^/(dev|proc|sys|run|var/lib/docker|var/lib/containerd)($$|/)"]
    volumes: ["/:/host:ro,rslave"]
  cadvisor:
    image: {{ img_cadvisor }}
    restart: unless-stopped
    privileged: true
    command: ["--docker_only=true", "--housekeeping_interval=30s", "--store_container_labels=false"]
    devices: ["/dev/kmsg"]
    volumes: ["/:/rootfs:ro", "/var/run:/var/run:ro", "/sys:/sys:ro", "/var/lib/docker/:/var/lib/docker:ro", "/dev/disk/:/dev/disk:ro"]
  grafana:
    image: {{ img_grafana }}
    restart: unless-stopped
    env_file: monitoring.env
{% if monitoring_grafana_public %}
    # PUBLIC on http://<server-ip>:{{ monitoring_grafana_port }} (plain HTTP; the login password is the only protection)
    ports: ["{{ monitoring_grafana_port }}:3000"]
{% else %}
    # reachable only through an SSH tunnel: ssh -L {{ monitoring_grafana_port }}:127.0.0.1:{{ monitoring_grafana_port }} {{ deploy_user }}@<server>
    ports: ["127.0.0.1:{{ monitoring_grafana_port }}:3000"]
{% endif %}
    volumes:
      - grafanadata:/var/lib/grafana
      - ./monitoring/grafana-datasource.yml:/etc/grafana/provisioning/datasources/prometheus.yml:ro
      - ./monitoring/grafana-dashboards.yml:/etc/grafana/provisioning/dashboards/staging.yml:ro
      - ./monitoring/staging-overview.json:/var/lib/grafana/dashboards/staging-overview.json:ro
    depends_on: [prometheus]
{% endif %}
volumes:
{% if not stack_external_mongo %}
  mongodata:
{% endif %}
  pgdata17:
{% if monitoring_enabled %}
  promdata:
  grafanadata:
{% endif %}
