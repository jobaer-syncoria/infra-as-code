# The omnisync API upstream: one line `server <colour>:8000;` in a file odoosync-deploy rewrites on every blue/green switch.
upstream web_backend {
  include /etc/nginx/odoosync/upstream-web.conf;
}

# internal listener (not published): lets clover-node reach omnisync through the same switch as the public API
server {
  listen 8000;
  location / {
    proxy_pass http://web_backend;
    proxy_set_header Host $host;
    proxy_read_timeout 240s;
  }
}

# edge: the public door on port 80. Admin UI (its own non-root image on 8080) and the omnisync API.
server {
  listen 80;
  server_name _;
  client_max_body_size 10m;
  gzip on;
  gzip_types text/plain text/css application/json application/javascript text/xml application/xml;

  location /api/ {
    proxy_pass http://web_backend/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 240s;   # NGINX_READ (ADR-04)
  }

  location / {
    proxy_pass http://admin-web:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
